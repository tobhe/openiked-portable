openiked for Debian
------------------

Upstream has not yet tagged a release or started releasing tarballs.
To create a new version based on the upstream git repository, from
the debian packaging branch, go:

    git remote | grep github || \
	git remote add github https://github.com/openiked/openiked-portable
    export DEBIAN_BRANCH=$(gbp config DEFAULT.debian-branch)
    export UPSTREAM_BRANCH=$(gbp config DEFAULT.upstream-branch)
    git switch ${UPSTREAM_BRANCH}
    git pull --ff-only github master
    git switch ${DEBIAN_BRANCH}
    export UPSTREAM_COMMIT=$(git rev-parse --short github/master)
    export UPSTREAM_TAG="0.0.0_git$(date +'%Y%m%d').${UPSTREAM_COMMIT}"
    gbp import-ref --upstream-tree=${UPSTREAM_COMMIT} -u"${UPSTREAM_TAG}"

 -- Ryan Kavanagh <rak@rak.ac>  Sat, 23 Jan 2021 13:09:55 -0500
